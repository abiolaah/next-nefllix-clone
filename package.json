{
  "name": "netflix-clone",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:report:all": "npm run test:report:unit && npm run test:report:integration",
    "test:unit": "jest --selectProjects=dom",
    "test:watch:unit": "jest --selectProjects=dom --watch",
    "test:coverage:unit": "jest --selectProjects=dom --coverage",
    "test:report:unit": "open-cli test-results/unit-tests/report.html",
    "test:integration": "jest --selectProjects=node",
    "test:watch:integration": "jest --selectProjects=node --watch",
    "test:coverage:integration": "jest --selectProjects=node --coverage",
    "test:report:integration": "open-cli test-results/integration-tests/report.html",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "lsof -ti:9323 | xargs kill -9 2>/dev/null || true && playwright show-report --port 9324",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "test:coverage": "jest --coverage",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:ci": "npm run test:unit -- --ci && npm run test:integration -- --ci && npm run test:e2e",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:seed": "node scripts/import-movies.js && node scripts/import-seasons.js",
    "setup:test-user": "tsx scripts/create-test-user.ts",
    "cleanup:test": "rm -rf test-results playwright-report playwright/.auth coverage",
    "dashboard:generate": "tsx scripts/generate-dashboard.ts",
    "dashboard:serve": "npm run dashboard:generate && npx http-server . -p 8080",
    "import-movies": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/import-movies.ts",
    "import-seasons": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' scripts/import-seasons.ts"
  },
  "dependencies": {
    "@faker-js/faker": "^9.7.0",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^6.6.0",
    "@types/testing-library__jest-dom": "^5.14.9",
    "axios": "^1.8.4",
    "bcrypt": "^5.1.1",
    "lodash": "^4.17.21",
    "next": "15.2.4",
    "next-auth": "^4.24.11",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.5.0",
    "swr": "^2.3.3",
    "tailwind-scrollbar-hide": "^2.0.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.27.2",
    "@babel/preset-react": "^7.27.1",
    "@babel/preset-typescript": "^7.27.1",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.1.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcrypt": "^5.0.2",
    "@types/jest": "^29.5.14",
    "@types/lodash": "^4.17.16",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.21",
    "babel-jest": "^29.7.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "15.2.4",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-environment-jsdom-sixteen": "^1.0.3",
    "jest-html-reporter": "^4.3.0",
    "postcss": "^8.5.3",
    "prisma": "^6.6.0",
    "tailwindcss": "^4.1.3",
    "ts-jest": "^29.3.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "^5"
  }
}
